#!/usr/bin/env python3

import xml.etree.ElementTree as ET
import random
import argparse
import sys
from pathlib import Path
from collections import deque
from difflib import get_close_matches
from books import BOOK_ABBREVIATIONS, OT_BOOKS, NT_BOOKS

BASE_DIR = Path(__file__).resolve().parent
FILE_PATH = BASE_DIR / "ESV.xml"

# Create reverse mapping from abbreviation to book name
ABBREV_TO_BOOK = {}
for book, abbrevs in BOOK_ABBREVIATIONS.items():
    for abbrev in abbrevs:
        ABBREV_TO_BOOK[abbrev] = book

# Pre-computed list for fuzzy matching (all lowercase for better matching)
ALL_BOOK_SEARCH_TERMS = list(ABBREV_TO_BOOK.keys())

# Mapping from book name to shortest abbreviation
BOOK_TO_SHORT_ABBREV = {}
for book, abbrevs in BOOK_ABBREVIATIONS.items():
    BOOK_TO_SHORT_ABBREV[book] = min(abbrevs, key=len)

def normalize_book_name(book_input):
    """Normalize and find the full book name from user input."""
    if not book_input:
        return None
    
    # Normalize input: lowercase and remove spaces
    normalized = book_input.lower().strip().replace(' ', '')
    
    # Direct lookup in reverse mapping
    if normalized in ABBREV_TO_BOOK:
        return ABBREV_TO_BOOK[normalized]
    
    return None

def find_similar_books(book_input):
    """Find similar book names for suggestions."""
    # Normalize input
    normalized = book_input.lower().strip()
    
    # Get close matches
    matches = get_close_matches(normalized, ALL_BOOK_SEARCH_TERMS, n=1, cutoff=0.6)
    
    if matches:
        return ABBREV_TO_BOOK[matches[0]]
    
    return None

def get_random_verses(file_path, count=1, book_filter=None):
    """Get random consecutive verses, optionally from a specific book, using Reservoir Sampling."""
    window = deque(maxlen=count)
    selected_window = None
    valid_window_count = 0
    all_verses_if_short = []
    
    context = ET.iterparse(file_path, events=('start', 'end'))
    current_book = None
    current_chapter = None
    
    for event, elem in context:
        if event == 'start':
            if elem.tag == 'b':
                current_book = elem.get('n')
            elif elem.tag == 'c':
                current_chapter = elem.get('n')
        elif event == 'end':
            if elem.tag == 'v':
                if (not book_filter or current_book == book_filter) and elem.text:
                    verse_data = (current_book, current_chapter, elem.get('n'), elem.text.strip())
                    
                    if len(all_verses_if_short) < count:
                        all_verses_if_short.append(verse_data)
                    
                    window.append(verse_data)
                    if len(window) == count:
                        valid_window_count += 1
                        if random.randrange(valid_window_count) == 0:
                            selected_window = list(window)
                            
                elem.clear()
            elif elem.tag in ('c', 'b'):
                elem.clear()
                
    if valid_window_count == 0:
        return all_verses_if_short
        
    return selected_window

def print_book_list():
    """Print the full list of books and their abbreviations."""
    print("Available Books and Their Abbreviations:")
    print("\nOld Testament:")
    for book, abbrev in OT_BOOKS:
        print(f"  {book:<20} ({abbrev})")

    print("\nNew Testament:")
    for book, abbrev in NT_BOOKS:
        print(f"  {book:<20} ({abbrev})")


def print_help():
    """Print a short help message that points users to `--list-books` for details."""
    print("Bible CLI - Get random verses from the Bible")
    print("\nUsage:")
    print("  bible              Get a random verse from any book")
    print("  bible [BOOK] [N]   Get N random consecutive verses (default 1)")
    print("  bible -b BOOK      Get a random verse from a specific book")
    print("  bible -n COUNT     Get N random consecutive verses")
    print("  bible -h           Show this short help message")
    print("  bible --list-books Show the full list of books and their abbreviations")
    print("  bible --update     Fetch latest code from GitHub and run installer")
    print("\nExamples:")
    print("  bible Genesis")
    print("  bible 1 Kings 5")
    print("  bible -b Gen -n 3")
    print("  bible --book=Psalms")
    

def main():
    parser = argparse.ArgumentParser(
        description='Bible CLI - Get random verses from the Bible',
        add_help=False  # We'll handle help ourselves
    )
    parser.add_argument('positional_book', nargs='*', help=argparse.SUPPRESS)
    parser.add_argument('-b', '--book', nargs='+', help='Specify a book to get verses from')
    parser.add_argument('-n', '--count', type=int, default=1, help='Number of consecutive verses to retrieve')
    parser.add_argument('-h', '--help', action='store_true', help='Show help message')
    parser.add_argument('--list-books', action='store_true', help='List all books and their abbreviations')
    parser.add_argument('--update', action='store_true', help='Fetch latest code and run installer for your platform')
    parser.add_argument('--check-update', action='store_true', help='Check whether an update is available (dry-run)')
    
    args = parser.parse_args()
    
    # Handle help
    if args.help:
        print_help()
        sys.exit(0)

    # Handle list-books
    if args.list_books:
        print_book_list()
        sys.exit(0)

    # Handle update via separate updater module
    if args.update:
        try:
            from updater import perform_update
        except Exception as e:
            print('Update support not available (missing updater module).', e)
            sys.exit(1)

        rc = perform_update(BASE_DIR)
        sys.exit(0 if rc == 0 else 1)

    if args.check_update:
        try:
            from updater import perform_update
        except Exception as e:
            print('Update support not available (missing updater module).', e)
            sys.exit(1)

        rc = perform_update(BASE_DIR, check_only=True)
        # Use exit codes: 0 == up-to-date, 2 == update available, 1 == error/cannot determine
        if rc == 0:
            sys.exit(0)
        elif rc == 2:
            # Indicate update available but do not perform it
            print('An update is available. Run `bible --update` to install it.')
            sys.exit(2)
        else:
            sys.exit(1)

    # Handle count
    count = args.count
    if args.positional_book:
        last_arg = args.positional_book[-1]
        if last_arg.isdigit():
            count = int(args.positional_book.pop())
            
    if count < 1:
        print("Error: Verse count must be a positive integer.")
        sys.exit(1)
    
    # Handle book filter
    input_book_parts = args.book or []
    if args.positional_book:
        input_book_parts.extend(args.positional_book)
        
    book_filter = None
    if input_book_parts:
        raw_book_str = ' '.join(input_book_parts)
        book_filter = normalize_book_name(raw_book_str)
        
        if not book_filter:
            # Try to find similar books
            similar = find_similar_books(raw_book_str)
            if similar:
                # Get the abbreviated form for the suggestion using pre-computed mapping
                short_form = BOOK_TO_SHORT_ABBREV.get(similar, similar)
                print(f"'{raw_book_str}' book doesn't exist, did you mean '{similar}' ({short_form})?")
            else:
                print(f"'{raw_book_str}' book is not present in the Bible.")
            sys.exit(1)
    
    # Get and display verses
    verses = get_random_verses(FILE_PATH, count, book_filter)
    
    if verses:
        if len(verses) == 1:
            # Single verse: old format
            book, ch, v, text = verses[0]
            print(f"{book} {ch}:{v} — {text}")
        else:
            # Multiple verses: paragraph format
            first_book, first_ch, first_v, _ = verses[0]
            last_book, last_ch, last_v, _ = verses[-1]
            
            if first_book == last_book:
                if first_ch == last_ch:
                    header = f"{first_book} {first_ch}:{first_v}-{last_v}"
                else:
                    header = f"{first_book} {first_ch}:{first_v} - {last_ch}:{last_v}"
            else:
                header = f"{first_book} {first_ch}:{first_v} - {last_book} {last_ch}:{last_v}"
                
            print(header)
            
            parts = []
            for book, ch, v, text in verses:
                if first_book != last_book:
                    label = f"[{book} {ch}:{v}]"
                elif first_ch != last_ch:
                    label = f"[{ch}:{v}]"
                else:
                    label = f"[{v}]"
                parts.append(f"{label} {text}\n")
                
            print(" ".join(parts))
    else:
        if book_filter:
            print(f"No verses found for the book: {book_filter}")
        else:
            print("No verses found.")
        sys.exit(1)

if __name__ == "__main__":
    main()
